# FPL Assistant — install with: crontab crontab.example
# Paths are absolute because cron runs with a minimal environment.
FPL=/Users/mihneacirstica/Desktop/BUILDING\ IN\ MY\ 20s/Fantasy\ League/fpl-assistant

# Injuries and status flags — every 2 hours, 08:00-22:00 local
0 8,10,12,14,16,18,20,22 * * * "$FPL/fpl" check status >> "$FPL/logs/cron.log" 2>&1

# Prices process ~01:30 UK. 21:00 Montreal = 02:00 UK.
0 21 * * * "$FPL/fpl" check prices >> "$FPL/logs/cron.log" 2>&1

# Deadline reminders — hourly; the T-minus windows decide when to fire.
5 * * * * "$FPL/fpl" check deadline >> "$FPL/logs/cron.log" 2>&1

# Rebuild the pitch view every morning.
30 7 * * * "$FPL/fpl" pitch >> "$FPL/logs/cron.log" 2>&1
